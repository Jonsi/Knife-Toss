# Handle line endings automatically for files detected as text
# and perform LF normalization (format in repo is always LF)
* text=auto

# Explicitly declare text files to always be normalized and use LF
*.cs text eol=lf
*.asmdef text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.editorconfig text eol=lf

# Unity YAML files (always LF)
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.spriteatlas text eol=lf

# Explicitly mark binary files - Git will not touch these
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
*.obj binary
*.zip binary
